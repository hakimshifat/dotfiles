include "./noctalia/animation.kdl"

// >>> shell-switch >>>
include "./noctalia/autostart.kdl"
include "./noctalia/keybinds.kdl"
// <<< shell-switch <<<

include "./noctalia/input.kdl"
include "./noctalia/display.kdl"
include "./noctalia/layout.kdl"
include "./noctalia/rules.kdl"
include "./noctalia/misc.kdl"

debug {
    // Force niri rendering onto the Intel HD 620 (primary/boot GPU).
    // Use the by-path link so this stays correct if renderD* numbering changes.
    render-drm-device "/dev/dri/by-path/pci-0000:00:02.0-render"
}

include "noctalia.kdl"

// Managed by the Noctalia cursor plugin - edits here are overwritten.
include "cursor.kdl"

// Java/Swing apps under XWayland don't process compositor-driven resizes,
// so tiling leaves the frame at tile size while Swing paints at its
// restored size -> unpainted white area. Keep them floating.
window-rule {
    match app-id="jadx-gui-JadxGUI"
    open-floating true
}
