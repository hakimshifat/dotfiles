layout {

    focus-ring {
        active-color   "#d5c0d9"
        inactive-color "#141314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d5c0d9"
        inactive-color "#141314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d5c0d9"
        inactive-color "#241729"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d5c0d980"
    }
}

recent-windows {
    highlight {
        active-color "#d5c0d9"
        urgent-color "#ffb4ab"
    }
}
