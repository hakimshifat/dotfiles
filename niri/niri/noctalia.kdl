layout {

    focus-ring {
        active-color   "#9cccf3"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9cccf3"
        inactive-color "#111416"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#9cccf3"
        inactive-color "#2b5e80"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9cccf380"
    }
}

recent-windows {
    highlight {
        active-color "#9cccf3"
        urgent-color "#ffb4ab"
    }
}
