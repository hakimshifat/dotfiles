layout {

    focus-ring {
        active-color   "#d5c697"
        inactive-color "#151310"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d5c697"
        inactive-color "#151310"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#d5c697"
        inactive-color "#352c0a"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#d5c69780"
    }
}

recent-windows {
    highlight {
        active-color "#d5c697"
        urgent-color "#ffb4ab"
    }
}
