layout {

    focus-ring {
        active-color   "#b9c8d9"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b9c8d9"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b9c8d9"
        inactive-color "#3c4a58"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b9c8d980"
    }
}

recent-windows {
    highlight {
        active-color "#b9c8d9"
        urgent-color "#ffb4ab"
    }
}
